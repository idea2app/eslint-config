{
  "name": "eslint-idea2app-next-js",
  "version": "0.1.1",
  "description": "Shared Next.js ESLint rules for idea2app projects",
  "license": "LGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/idea2app/eslint-config",
    "directory": "packages/eslint-idea2app-next-js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --target node22 --out-dir dist",
    "test": "eslint --fix . && tsc --noEmit"
  },
  "dependencies": {
    "@next/eslint-plugin-next": ">=16",
    "eslint-idea2app-tsx": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
